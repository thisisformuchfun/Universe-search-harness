SELECT TOP 100 table_name,column_name,datatype,unit,description FROM TAP_SCHEMA.columns WHERE (table_name='sdss_dr17.specobj' OR table_name='sdss_dr17.x1p5__specobj__gaia_dr3__gaia_source') AND column_name IN ('id1','id2','distance','ra1','dec1','ra2','dec2','specobjid','plate','mjd','fiberid','ra','dec','run2d','class','subclass','snmedian','zwarning') ORDER BY table_name,column_name
