<?xml version="1.0" encoding="utf-8"?>
<VOTABLE version="1.4" xmlns="http://www.ivoa.net/xml/VOTable/v1.3" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.ivoa.net/xml/VOTable/v1.3 http://www.ivoa.net/xml/VOTable/votable-1.4.xsd">
<RESOURCE type="results">
<INFO name="QUERY_STATUS" value="OK"/>
<INFO name="PROVIDER" value="ARI (Astronomisches Rechen Institut - Heidelberg, Germany)">ARI's TAP access to the Gaia Archive.</INFO>
<INFO name="QUERY" value="SELECT source_id,ra,dec,ref_epoch,parallax,parallax_error,pmra,pmra_error,pmdec,pmdec_error,parallax_pmra_corr,parallax_pmdec_corr,pmra_pmdec_corr,phot_g_mean_mag,bp_rp,ruwe,duplicated_source,ipd_frac_multi_peak,ipd_gof_harmonic_amplitude,astrometric_params_solved,3600*DISTANCE(POINT('ICRS',ra,dec),POINT('ICRS',185.71462554756414,40.88393733581962)) AS separation_arcsec FROM gaiadr3.gaia_source WHERE 1=CONTAINS(POINT('ICRS',ra,dec),CIRCLE('ICRS',185.71462554756414,40.88393733581962,0.0166666666666667)) ORDER BY source_id"/>
<COOSYS ID="GDR3_ICRS" system="ICRS" epoch="2016" />
<TABLE name="result_S1793483469939">
<FIELD ID="source_id" datatype="long" name="source_id" ucd="meta.id;meta.main">
<DESCRIPTION>Unique source identifier (unique within a particular Data Release)</DESCRIPTION>
</FIELD>
<FIELD ID="ra" datatype="double" name="ra" ref="GDR3_ICRS" ucd="pos.eq.ra;meta.main" unit="deg">
<DESCRIPTION>Right ascension</DESCRIPTION>
</FIELD>
<FIELD ID="dec" datatype="double" name="dec" ref="GDR3_ICRS" ucd="pos.eq.dec;meta.main" unit="deg">
<DESCRIPTION>Declination</DESCRIPTION>
</FIELD>
<FIELD ID="ref_epoch" datatype="double" name="ref_epoch" ucd="meta.ref;time.epoch" unit="yr">
<DESCRIPTION>Reference epoch</DESCRIPTION>
</FIELD>
<FIELD ID="parallax" datatype="double" name="parallax" ucd="pos.parallax.trig" unit="mas">
<DESCRIPTION>Parallax</DESCRIPTION>
</FIELD>
<FIELD ID="parallax_error" datatype="float" name="parallax_error" ucd="stat.error;pos.parallax.trig" unit="mas">
<DESCRIPTION>Standard error of parallax</DESCRIPTION>
</FIELD>
<FIELD ID="pmra" datatype="double" name="pmra" ucd="pos.pm;pos.eq.ra" unit="mas.yr**-1">
<DESCRIPTION>Proper motion in right ascension direction</DESCRIPTION>
</FIELD>
<FIELD ID="pmra_error" datatype="float" name="pmra_error" ucd="stat.error;pos.pm;pos.eq.ra" unit="mas.yr**-1">
<DESCRIPTION>Standard error of proper motion in right ascension direction</DESCRIPTION>
</FIELD>
<FIELD ID="pmdec" datatype="double" name="pmdec" ucd="pos.pm;pos.eq.dec" unit="mas.yr**-1">
<DESCRIPTION>Proper motion in declination direction</DESCRIPTION>
</FIELD>
<FIELD ID="pmdec_error" datatype="float" name="pmdec_error" ucd="stat.error;pos.pm;pos.eq.dec" unit="mas.yr**-1">
<DESCRIPTION>Standard error of proper motion in declination direction</DESCRIPTION>
</FIELD>
<FIELD ID="parallax_pmra_corr" datatype="float" name="parallax_pmra_corr" ucd="stat.correlation">
<DESCRIPTION>Correlation between parallax and proper motion in right ascension</DESCRIPTION>
</FIELD>
<FIELD ID="parallax_pmdec_corr" datatype="float" name="parallax_pmdec_corr" ucd="stat.correlation">
<DESCRIPTION>Correlation between parallax and proper motion in declination</DESCRIPTION>
</FIELD>
<FIELD ID="pmra_pmdec_corr" datatype="float" name="pmra_pmdec_corr" ucd="stat.correlation">
<DESCRIPTION>Correlation between proper motion in right ascension and proper motion in declination</DESCRIPTION>
</FIELD>
<FIELD ID="phot_g_mean_mag" datatype="float" name="phot_g_mean_mag" ucd="phot.mag;em.opt" unit="mag">
<DESCRIPTION>G-band mean magnitude</DESCRIPTION>
</FIELD>
<FIELD ID="bp_rp" datatype="float" name="bp_rp" ucd="phot.color;em.opt.B;em.opt.R" unit="mag">
<DESCRIPTION>BP - RP colour</DESCRIPTION>
</FIELD>
<FIELD ID="ruwe" datatype="float" name="ruwe" ucd="stat.error">
<DESCRIPTION>Renormalised unit weight error</DESCRIPTION>
</FIELD>
<FIELD ID="duplicated_source" datatype="short" name="duplicated_source" ucd="meta.code.status">
<DESCRIPTION>Source with multiple source identifiers</DESCRIPTION>
</FIELD>
<FIELD ID="ipd_frac_multi_peak" datatype="short" name="ipd_frac_multi_peak" ucd="stat.value">
<DESCRIPTION>Percent of successful-IPD windows with more than one peak</DESCRIPTION>
</FIELD>
<FIELD ID="ipd_gof_harmonic_amplitude" datatype="float" name="ipd_gof_harmonic_amplitude" ucd="stat.value">
<DESCRIPTION>Amplitude of the IPD GoF versus position angle of scan</DESCRIPTION>
</FIELD>
<FIELD ID="astrometric_params_solved" datatype="short" name="astrometric_params_solved" ucd="meta.number">
<DESCRIPTION>Which parameters have been solved for?</DESCRIPTION>
</FIELD>
<FIELD ID="separation_arcsec" datatype="double" name="separation_arcsec"/>
