</FIELD>
<FIELD ID="pseudocolour" datatype="float" name="pseudocolour" ucd="em.wavenumber" unit="um**-1">
<DESCRIPTION>Astrometrically estimated pseudocolour of the source</DESCRIPTION>
</FIELD>
<FIELD ID="pseudocolour_error" datatype="float" name="pseudocolour_error" ucd="stat.error;em.wavenumber" unit="um**-1">
<DESCRIPTION>Standard error of the pseudocolour of the source</DESCRIPTION>
</FIELD>
<FIELD ID="ra_dec_corr" datatype="float" name="ra_dec_corr" ucd="stat.correlation">
<DESCRIPTION>Correlation between right ascension and declination</DESCRIPTION>
</FIELD>
<FIELD ID="radial_velocity" datatype="float" name="radial_velocity" ucd="spect.dopplerVeloc.opt;em.opt.I" unit="km.s**-1">
<DESCRIPTION>Radial velocity</DESCRIPTION>
</FIELD>
<FIELD ID="radial_velocity_error" datatype="float" name="radial_velocity_error" ucd="stat.error;spect.dopplerVeloc.opt;em.opt.I" unit="km.s**-1">
<DESCRIPTION>Radial velocity error</DESCRIPTION>
</FIELD>
<FIELD ID="random_index" datatype="long" name="random_index" ucd="meta.code">
<DESCRIPTION>Random index for use when selecting subsets</DESCRIPTION>
</FIELD>
<FIELD ID="ra_parallax_corr" datatype="float" name="ra_parallax_corr" ucd="stat.correlation">
<DESCRIPTION>Correlation between right ascension and parallax</DESCRIPTION>
</FIELD>
<FIELD ID="ra_pmdec_corr" datatype="float" name="ra_pmdec_corr" ucd="stat.correlation">
<DESCRIPTION>Correlation between right ascension and proper motion in declination</DESCRIPTION>
</FIELD>
<FIELD ID="ra_pmra_corr" datatype="float" name="ra_pmra_corr" ucd="stat.correlation">
<DESCRIPTION>Correlation between right ascension and proper motion in right ascension</DESCRIPTION>
</FIELD>
<FIELD ID="ra_pseudocolour_corr" datatype="float" name="ra_pseudocolour_corr" ucd="stat.correlation;em.wavenumber;pos.eq.ra">
<DESCRIPTION>Correlation between right ascension and pseudocolour</DESCRIPTION>
</FIELD>
<FIELD ID="ref_epoch" datatype="double" name="ref_epoch" ucd="meta.ref;time.epoch" unit="yr">
<DESCRIPTION>Reference epoch</DESCRIPTION>
</FIELD>
<FIELD ID="rv_amplitude_robust" datatype="float" name="rv_amplitude_robust" ucd="stat.error;spect.dopplerVeloc.opt;em.opt.I" unit="km.s**-1">
<DESCRIPTION>Total amplitude in the radial velocity time series after outlier removal</DESCRIPTION>
</FIELD>
<FIELD ID="rv_atm_param_origin" datatype="short" name="rv_atm_param_origin" ucd="meta.code.class">
<DESCRIPTION>Origin of the atmospheric parameters associated to the template</DESCRIPTION>
</FIELD>
<FIELD ID="rv_chisq_pvalue" datatype="float" name="rv_chisq_pvalue" ucd="stat.fit.param">
<DESCRIPTION>P-value for constancy based on a chi-squared criterion</DESCRIPTION>
</FIELD>
<FIELD ID="rv_expected_sig_to_noise" datatype="float" name="rv_expected_sig_to_noise" ucd="stat.snr">
<DESCRIPTION>Expected signal to noise ratio in the combination of the spectra used to obtain the radial velocity</DESCRIPTION>
</FIELD>
<FIELD ID="rv_method_used" datatype="short" name="rv_method_used" ucd="meta.code.class">
<DESCRIPTION>Method used to obtain the radial velocity</DESCRIPTION>
</FIELD>
<FIELD ID="rv_nb_deblended_transits" datatype="short" name="rv_nb_deblended_transits" ucd="meta.number">
<DESCRIPTION>Number of valid transits that have undergone deblending</DESCRIPTION>
</FIELD>
<FIELD ID="rv_nb_transits" datatype="short" name="rv_nb_transits" ucd="meta.number">
<DESCRIPTION>Number of transits used to compute the radial velocity</DESCRIPTION>
</FIELD>
<FIELD ID="rv_renormalised_gof" datatype="float" name="rv_renormalised_gof" ucd="stat.fit.goodness">
<DESCRIPTION>Radial velocity renormalised goodness of fit</DESCRIPTION>
</FIELD>
<FIELD ID="rvs_spec_sig_to_noise" datatype="float" name="rvs_spec_sig_to_noise" ucd="stat.snr">
<DESCRIPTION>Signal to noise ratio in the mean RVS spectrum</DESCRIPTION>
</FIELD>
<FIELD ID="rv_template_fe_h" datatype="float" name="rv_template_fe_h" ucd="stat.fit.param" unit="dex">
<DESCRIPTION>[Fe/H] of the template used to compute the radial velocityy</DESCRIPTION>
</FIELD>
<FIELD ID="rv_template_logg" datatype="float" name="rv_template_logg" ucd="stat.fit.param" unit="log(cm.s**-2)">
<DESCRIPTION>Logg of the template used to compute the radial velocity</DESCRIPTION>
</FIELD>
<FIELD ID="rv_template_teff" datatype="float" name="rv_template_teff" ucd="stat.fit.param" unit="K">
<DESCRIPTION>Teff of the template used to compute the radial velocity</DESCRIPTION>
</FIELD>
<FIELD ID="rv_time_duration" datatype="float" name="rv_time_duration" ucd="time.duration" unit="d">
<DESCRIPTION>Time coverage of the radial velocity time series</DESCRIPTION>
</FIELD>
<FIELD ID="rv_visibility_periods_used" datatype="short" name="rv_visibility_periods_used" ucd="meta.number">
<DESCRIPTION>Number of visibility periods used to estimate the radial velocity</DESCRIPTION>
</FIELD>
<FIELD ID="scan_direction_mean_k1" datatype="float" name="scan_direction_mean_k1" ucd="pos.posAng;stat.mean" unit="deg">
<DESCRIPTION>Mean position angle of scan directions across the source</DESCRIPTION>
</FIELD>
<FIELD ID="scan_direction_mean_k2" datatype="float" name="scan_direction_mean_k2" ucd="pos.posAng;stat.mean" unit="deg">
<DESCRIPTION>Mean position angle of scan directions across the source</DESCRIPTION>
</FIELD>
<FIELD ID="scan_direction_mean_k3" datatype="float" name="scan_direction_mean_k3" ucd="pos.posAng;stat.mean" unit="deg">
<DESCRIPTION>Mean position angle of scan directions across the source</DESCRIPTION>
</FIELD>
<FIELD ID="scan_direction_mean_k4" datatype="float" name="scan_direction_mean_k4" ucd="pos.posAng;stat.mean" unit="deg">
<DESCRIPTION>Mean position angle of scan directions across the source</DESCRIPTION>
</FIELD>
<FIELD ID="scan_direction_strength_k1" datatype="float" name="scan_direction_strength_k1" ucd="stat.value">
<DESCRIPTION>Degree of concentration of scan directions across the source</DESCRIPTION>
</FIELD>
<FIELD ID="scan_direction_strength_k2" datatype="float" name="scan_direction_strength_k2" ucd="stat.value">
<DESCRIPTION>Degree of concentration of scan directions across the source</DESCRIPTION>
</FIELD>
<FIELD ID="scan_direction_strength_k3" datatype="float" name="scan_direction_strength_k3" ucd="stat.value">
<DESCRIPTION>Degree of concentration of scan directions across the source</DESCRIPTION>
</FIELD>
<FIELD ID="scan_direction_strength_k4" datatype="float" name="scan_direction_strength_k4" ucd="stat.value">
<DESCRIPTION>Degree of concentration of scan directions across the source</DESCRIPTION>
</FIELD>
<FIELD ID="solution_id" datatype="long" name="solution_id" ucd="meta.version">
<DESCRIPTION>Solution Identifier</DESCRIPTION>
</FIELD>
<FIELD ID="teff_gspphot" datatype="float" name="teff_gspphot" ucd="phys.temperature.effective" unit="K">
<DESCRIPTION>Effective temperature from GSP-Phot Aeneas best library using BP/RP spectra</DESCRIPTION>
</FIELD>
<FIELD ID="teff_gspphot_lower" datatype="float" name="teff_gspphot_lower" ucd="phys.temperature.effective;stat.min" unit="K">
<DESCRIPTION>Lower confidence level (16%) of effective temperature from GSP-Phot Aeneas best library using BP/RP spectra</DESCRIPTION>
</FIELD>
<FIELD ID="teff_gspphot_upper" datatype="float" name="teff_gspphot_upper" ucd="phys.temperature.effective;stat.max" unit="K">
<DESCRIPTION>Upper confidence level (84%) of effective temperature from GSP-Phot Aeneas best library using BP/RP spectra</DESCRIPTION>
</FIELD>
<FIELD ID="vbroad" datatype="float" name="vbroad" ucd="spect.dopplerVeloc.opt;em.opt.I" unit="km.s**-1">
<DESCRIPTION>Spectral line broadening parameter</DESCRIPTION>
</FIELD>
<FIELD ID="vbroad_error" datatype="float" name="vbroad_error" ucd="stat.error;spect.dopplerVeloc.opt;em.opt.I" unit="km.s**-1">
<DESCRIPTION>Uncertainty on the spectral line broadening</DESCRIPTION>
</FIELD>
<FIELD ID="vbroad_nb_transits" datatype="short" name="vbroad_nb_transits" ucd="meta.number">
<DESCRIPTION>Number of transits used to compute vbroad</DESCRIPTION>
</FIELD>
<FIELD ID="visibility_periods_used" datatype="short" name="visibility_periods_used" ucd="meta.number">
<DESCRIPTION>Number of visibility periods used in Astrometric solution</DESCRIPTION>
</FIELD>
