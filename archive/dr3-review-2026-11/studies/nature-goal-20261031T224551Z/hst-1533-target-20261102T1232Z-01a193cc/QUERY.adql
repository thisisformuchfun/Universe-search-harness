SELECT TOP 20 objid,obs_collection,facility_name,instrument_name,target_name,obs_id,obs_publisher_did,dataproduct_type,calib_level,s_region,s_ra,s_dec,s_fov,s_resolution,s_xel1,s_xel2,t_min,t_max,t_exptime,t_resolution,t_xel,em_min,em_max,em_res_power,em_xel,pol_states,pol_xel,o_ucd,access_url,access_format,access_estsize FROM ivoa.obscore WHERE obs_collection='HST' AND dataproduct_type='image' AND CONTAINS(POINT('ICRS',185.71462554756414,40.88393733581962),s_region)=1 ORDER BY objid
